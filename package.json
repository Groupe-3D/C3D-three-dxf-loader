{
  "name": "three-dxf-loader",
  "version": "5.5.0",
  "description": "Cross platform DXF loader for three.js. Out of the box usable with react-three-fiber.",
  "type": "module",
  "main": "src/loader/index.js",
  "module": "src/loader/index.js",
  "types": "src/loader/index.d.ts",
  "scripts": {
    "build-dev": "cross-env NODE_ENV=development webpack -c webpack.config.js",
    "build": "cross-env NODE_ENV=production webpack -c webpack.config.js",
    "prepublishOnly": "pnpm build",
    "start-web": "pnpm install && pnpm build && cd examples/web && pnpm install && pnpm start",
    "start-r3f": "pnpm install && pnpm build && cd examples/r3f && pnpm install && pnpm start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "biome:ci": "biome ci .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./src/loader/index.d.ts",
      "import": "./src/loader/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prolincur/three-dxf-loader"
  },
  "bugs": {
    "url": "https://github.com/prolincur/three-dxf-loader/issues"
  },
  "homepage": "https://github.com/prolincur/three-dxf-loader",
  "author": "Prolincur Technologies (prolincur.com) and GDS Storefront Estimating (gdsestimating.com)",
  "contributors": [
    "Sourabh Soni <https://www.prolincur.com>",
    "Ben Zuill-Smith <bzuillsmith@gmail.com>"
  ],
  "license": "MIT",
  "files": [
    "src",
    "dist/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/three": "^0.173.0",
    "cross-env": "^7.0.3",
    "html-webpack-plugin": "^5.5.0",
    "typescript": "^5.9.3",
    "webpack": "^5.52.1",
    "webpack-cli": "^4.8.0",
    "webpack-node-externals": "^3.0.0"
  },
  "peerDependencies": {
    "three": ">=0.129.0"
  },
  "keywords": [
    "dxf",
    "cad",
    "viewer",
    "threejs",
    "react-three-fiber",
    "r3f",
    "three",
    "loader",
    "3d",
    "2d",
    "drawings"
  ],
  "dependencies": {
    "@dxfom/mtext": "^0.3.2",
    "dxf-parser": "^1.1.2",
    "js-base64": "^3.7.3",
    "troika-three-text": "^0.52.4"
  }
}
